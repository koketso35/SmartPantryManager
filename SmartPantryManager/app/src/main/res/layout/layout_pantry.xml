<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue_dark"
            android:padding="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvPantryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/medium_gray"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:text="0 items" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <TextView
            android:id="@+id/tvEmptyPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/no_ingredients"
            android:textSize="16sp"
            android:textColor="@color/medium_gray"
            android:visibility="gone"
            android:padding="32dp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/accent_red"
        app:tint="@color/white"
        app:elevation="6dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
